###############################################
# Neon (Recommended) — copy to .env locally   #
###############################################
# Keep names UPPERCASE: DATABASE_URL / DIRECT_URL
# Pooler (for Vercel serverless) — replace placeholders
DATABASE_URL="postgresql://neondb_owner:<ENCODED_PASSWORD>@<POOLER_HOST>/<DB_NAME>?sslmode=require&pgbouncer=true&connection_limit=1"
# Direct (for prisma db push/migrate/psql)
DIRECT_URL="postgresql://neondb_owner:<ENCODED_PASSWORD>@<DIRECT_HOST>/<DB_NAME>?sslmode=require"

# Optional public base URL override
NEXT_PUBLIC_API_BASE=""

